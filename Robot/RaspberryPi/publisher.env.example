# /etc/veil-publisher/publisher.env — owner root:veil-cam, mode 640. Never commit the real file.
# Generate the device credentials with: node UI/tools/stream-admin.mjs device robot-01 cam

# ── Where to publish ──
# Remote (production): MediaMTX on the VPS over RTSPS (TLS).
STREAM_SERVER_URL=rtsps://media.example.com:8322
# LAN only (MediaMTX on the Pi itself, no credentials): rtsp://127.0.0.1:8554
STREAM_NAME=cam

# ── Device identity ──
# With STREAM_TOKEN_URL the Pi exchanges these for a 5-minute publish token before every connection.
STREAM_TOKEN_URL=https://veil.example.com/api/stream/publish-token
STREAM_USERNAME=robot-01
STREAM_PASSWORD=
# STREAM_TLS_VERIFY=1        # keep 1; 0 only for a lab server with a self-signed cert
# STREAM_CA_FILE=            # PEM for a private CA (media server only)

# ── Camera ──
# auto = CSI camera if libcamera sees one, else the first USB webcam. Also: csi, usb, test (no camera).
CAMERA_TYPE=auto
# CSI index ("0", "1") or V4L2 device ("/dev/video0"). Empty = first found.
CAMERA_DEVICE=
# USB only: opencv (default) or ffmpeg (ffmpeg reads the camera directly: less CPU).
USB_BACKEND=opencv

# ── Video ──
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
# bit/s; also accepts 2500k / 2M. ~1.5–2.5M is a good range for 720p30.
VIDEO_BITRATE=2M
# Seconds between keyframes. A viewer joining (or recovering) waits up to this long for a picture.
VIDEO_KEYFRAME_INTERVAL=1
# auto: hardware H.264 when it actually works (Pi Zero 2 – Pi 4), else libx264. Pi 5 has no H.264 encoder.
VIDEO_ENCODER=auto

# ── Recovery ──
RECONNECT_MAX_DELAY=30
STALL_TIMEOUT=10
LOG_LEVEL=INFO

# Remote camera stream — Vercel → Project "veil" → Settings → Environment Variables (Production).
# Generate values with node tools/stream-admin.mjs (keys | viewer | device). Never commit real values.
# Without these, /api/stream/* answers 503 and the rest of VEIL works as before.

STREAM_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
STREAM_SESSION_SECRET=
# Must equal the MediaMTX authJWTIssuer (deployment/.env VEIL_ORIGIN + /api/stream)
STREAM_JWT_ISSUER=https://veil.example.com/api/stream
STREAM_JWT_AUDIENCE=mediamtx
# Public HTTPS origin of the MediaMTX VPS (Caddy)
STREAM_WHEP_BASE=https://media.example.com

# JSON arrays. Entries come from stream-admin.mjs; only scrypt hashes are stored.
STREAM_VIEWERS=[{"user":"alice","hash":"scrypt$...","paths":["cam"]}]
STREAM_PUBLISHERS=[{"id":"robot-01","hash":"scrypt$...","path":"cam"}]

# Optional
# STREAM_JWT_EXTRA_PUBLIC_KEYS=     # key rotation (Docs/streaming/security.md)
# STREAM_VIEW_TOKEN_TTL=120
# STREAM_PUBLISH_TOKEN_TTL=300
# STREAM_SESSION_TTL=43200

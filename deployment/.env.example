# Copy to deployment/.env (chmod 600). Never commit .env.

# Public name of this VPS. DNS A record → PUBLIC_IP, before the first start (Let's Encrypt).
MEDIA_DOMAIN=media.example.com
ACME_EMAIL=ops@example.com

# Public IPv4 of the VPS. On clouds where it is NOT on a network interface (AWS/GCP/Azure 1:1 NAT),
# also set PRIVATE_IP to the interface address.
PUBLIC_IP=203.0.113.10
PRIVATE_IP=

# VEIL on Vercel. JWKS + issuer are derived from VEIL_ORIGIN; VEIL_ORIGINS (comma-separated)
# lists every origin allowed to call WHEP from the browser (custom domain + vercel.app).
VEIL_ORIGIN=https://veil.example.com
VEIL_ORIGINS=https://veil.example.com

# node UI/tools/stream-admin.mjs turn-secret
TURN_SECRET=
